# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=aurora-bazzite

# Make this the same as your github username/organisation
REPO_ORGANIZATION="dracinn"

IMAGE_DESC="Custom bootc image for Apple Silicon, built on Fedora and the Aurora Silicon hardware stack"
IMAGE_KEYWORDS="bootc,oci,linux,apple-silicon,arm64,aarch64"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/ublue-os/bazzite/main/press_kit/Bazzite_Color.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
