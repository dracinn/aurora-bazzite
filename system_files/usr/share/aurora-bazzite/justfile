# Aurora Bazzite user commands — run `ujust` to list recipes

# Update the system image and all flatpaks
update:
    sudo bootc upgrade
    flatpak update -y

# Install the gaming flatpak set from Flathub
setup-flatpaks:
    flatpak install -y flathub \
        com.heroicgameslauncher.hgl \
        com.discordapp.Discord \
        net.davidotek.pupgui2 \
        org.prismlauncher.PrismLauncher \
        com.obsproject.Studio

# Create a mutable Fedora container for anything rpm won't do
box name="fedora":
    distrobox create --name {{name}} --image registry.fedoraproject.org/fedora-toolbox:44
    @echo "Enter with: distrobox enter {{name}}"

# Show image and kernel info
info:
    @bootc status --booted
    @uname -r
